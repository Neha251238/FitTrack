<%- include("partials/header") %>

<!-- ================= SIDEBAR ================= -->

<!-- ================= MAIN CONTENT ================= -->

<main class="main">

    <!-- PAGE HEADER -->

    <div class="page-header">

        <div>
            <h1>
                <i class="fa-solid fa-user"></i>
                My Profile
            </h1>

            <p>
                Manage your personal fitness information
            </p>
        </div>

    </div>


    <!-- ================= PROFILE LAYOUT ================= -->

    <div class="profile-layout">


        <!-- ================= PERSONAL INFORMATION ================= -->

        <div class="profile-card">

            <!-- PROFILE TOP -->

            <div class="profile-top">

                <!-- AVATAR -->

                <div class="big-avatar">

                    <%= user.name
                        ? user.name.charAt(0).toUpperCase()
                        : "U"
                    %>

                </div>


                <!-- USER DETAILS -->

                <div>

                    <h2>
                        <%= user.name || "User" %>
                    </h2>

                    <p>
                        <%= user.email || "" %>
                    </p>

                    <span>
                        <i class="fa-solid fa-circle-check"></i>
                        Fitness Member
                    </span>

                </div>

            </div>


            <!-- ================= FORM ================= -->

            <form
                action="/profile/update"
                method="POST"
            >

                <h3>
                    <i class="fa-solid fa-address-card"></i>
                    Personal Information
                </h3>


                <div class="form-grid">


                    <!-- FULL NAME -->

                    <div class="form-group">

                        <label>
                            <i class="fa-solid fa-user"></i>
                            Full Name
                        </label>

                        <input
                            type="text"
                            name="name"
                            value="<%= user.name || '' %>"
                            placeholder="Enter your name"
                            required
                        >

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label>
                            <i class="fa-solid fa-envelope"></i>
                            Email
                        </label>

                        <input
                            type="email"
                            value="<%= user.email || '' %>"
                            disabled
                        >

                    </div>


                    <!-- AGE -->

                    <div class="form-group">

                        <label>
                            <i class="fa-solid fa-calendar-days"></i>
                            Age
                        </label>

                        <input
                            type="number"
                            name="age"
                            value="<%= user.age || '' %>"
                            placeholder="Enter age"
                        >

                    </div>


                    <!-- HEIGHT -->

                    <div class="form-group">

                        <label>
                            <i class="fa-solid fa-ruler-vertical"></i>
                            Height (cm)
                        </label>

                        <input
                            type="number"
                            name="height"
                            value="<%= user.height || '' %>"
                            placeholder="Enter height"
                        >

                    </div>


                    <!-- WEIGHT -->

                    <div class="form-group">

                        <label>
                            <i class="fa-solid fa-weight-scale"></i>
                            Weight (kg)
                        </label>

                        <input
                            type="number"
                            step="0.1"
                            name="weight"
                            value="<%= user.weight || '' %>"
                            placeholder="Enter weight"
                        >

                    </div>


                    <!-- FITNESS GOAL -->

                    <div class="form-group">

                        <label>
                            <i class="fa-solid fa-bullseye"></i>
                            Fitness Goal
                        </label>

                        <select name="goal">

                            <option
                                value="Weight Loss"
                                <%= user.goal === "Weight Loss" ? "selected" : "" %>
                            >
                                Weight Loss
                            </option>

                            <option
                                value="Muscle Gain"
                                <%= user.goal === "Muscle Gain" ? "selected" : "" %>
                            >
                                Muscle Gain
                            </option>

                            <option
                                value="General Fitness"
                                <%= user.goal === "General Fitness" ? "selected" : "" %>
                            >
                                General Fitness
                            </option>

                            <option
                                value="Body Building"
                                <%= user.goal === "Body Building" ? "selected" : "" %>
                            >
                                Body Building
                            </option>

                            <option
                                value="Weight Maintenance"
                                <%= user.goal === "Weight Maintenance" ? "selected" : "" %>
                            >
                                Weight Maintenance
                            </option>

                        </select>

                    </div>

                </div>


                <!-- SAVE BUTTON -->

                <button
                    type="submit"
                    class="save-btn"
                >
                    <i class="fa-solid fa-floppy-disk"></i>
                    Save Changes
                </button>

            </form>

        </div>


        <!-- ================= FITNESS SUMMARY ================= -->

        <div class="summary">

            <h2>
                <i class="fa-solid fa-chart-simple"></i>
                Fitness Summary
            </h2>


            <div class="summary-grid">


                <!-- AGE -->

                <div class="summary-box">

                    <div class="summary-icon age-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>

                    <span>
                        Age
                    </span>

                    <strong>
                        <%= user.age || 0 %>
                    </strong>

                    <small>
                        Years
                    </small>

                </div>


                <!-- HEIGHT -->

                <div class="summary-box">

                    <div class="summary-icon height-icon">
                        <i class="fa-solid fa-ruler-vertical"></i>
                    </div>

                    <span>
                        Height
                    </span>

                    <strong>
                        <%= user.height || 0 %>
                    </strong>

                    <small>
                        cm
                    </small>

                </div>


                <!-- WEIGHT -->

                <div class="summary-box">

                    <div class="summary-icon weight-icon">
                        <i class="fa-solid fa-weight-scale"></i>
                    </div>

                    <span>
                        Weight
                    </span>

                    <strong>
                        <%= user.weight || 0 %>
                    </strong>

                    <small>
                        kg
                    </small>

                </div>


                <!-- BMI -->

                <div class="summary-box">

                    <div class="summary-icon bmi-icon">
                        <i class="fa-solid fa-scale-balanced"></i>
                    </div>

                    <span>
                        BMI
                    </span>

                    <strong id="bmi">
                        --
                    </strong>

                    <small>
                        Current BMI
                    </small>

                </div>

            </div>

        </div>

    </div>

</main>


<!-- ================= BMI SCRIPT ================= -->

<script>

    const weight = Number(
        "<%= user.weight || 0 %>"
    );

    const height = Number(
        "<%= user.height || 0 %>"
    );

    if (weight > 0 && height > 0) {

        const heightMeter = height / 100;

        const bmi =
            weight / (heightMeter * heightMeter);

        document.getElementById("bmi")
            .innerText = bmi.toFixed(1);

    } else {

        document.getElementById("bmi")
            .innerText = "--";

    }

</script>

</body>
</html>