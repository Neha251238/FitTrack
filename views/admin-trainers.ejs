<%- include("partials/header") %>

<!-- ADMIN SIDEBAR -->
<!-- MAIN -->
<main class="main">

    <!-- HEADER -->
    <div class="header">

        <div class="page-heading">

            <div>
                <span class="page-label">
                    <i class="fa-solid fa-user-tie"></i>
                    TRAINER MANAGEMENT
                </span>

                <h1>Manage Trainers</h1>

                <p>
                    Add, edit and manage FitTrack trainers.
                </p>
            </div>

            <a href="/admin/trainers/add" class="add-btn">
                <i class="fa-solid fa-plus"></i>
                Add Trainer
            </a>

        </div>

    </div>


    <!-- TRAINER GRID -->
    <div class="trainer-grid">

        <% if (trainers && trainers.length > 0) { %>

            <% trainers.forEach(trainer => { %>

                <div class="trainer-card">

                    <!-- ICON -->
                    <div class="trainer-icon">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>


                    <!-- TRAINER NAME -->
                    <h2>
                        <%= trainer.name %>
                    </h2>


                    <!-- SPECIALIZATION -->
                    <div class="trainer-info">

                        <div class="info-row">

                            <span>
                                <i class="fa-solid fa-dumbbell"></i>
                                Specialization
                            </span>

                            <strong>
                                <%= trainer.specialization %>
                            </strong>

                        </div>


                        <!-- EXPERIENCE -->
                        <div class="info-row">

                            <span>
                                <i class="fa-solid fa-briefcase"></i>
                                Experience
                            </span>

                            <strong>
                                <%= trainer.experience %> Years
                            </strong>

                        </div>


                        <!-- AVAILABILITY -->
                        <div class="info-row">

                            <span>
                                <i class="fa-solid fa-clock"></i>
                                Availability
                            </span>

                            <strong>
                                <%= trainer.availability %>
                            </strong>

                        </div>

                    </div>


                    <!-- ACTIONS -->
                    <div class="action-buttons">

                        <a
                            href="/admin/trainers/edit/<%= trainer._id %>"
                            class="edit-btn"
                        >
                            <i class="fa-solid fa-pen-to-square"></i>
                            Edit
                        </a>


                        <form
                            action="/admin/trainers/delete/<%= trainer._id %>"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="delete-btn"
                                onclick="return confirm('Are you sure you want to delete this trainer?')"
                            >
                                <i class="fa-solid fa-trash"></i>
                                Delete
                            </button>

                        </form>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <!-- EMPTY STATE -->

            <div class="empty-state">

                <div class="empty-icon">
                    <i class="fa-solid fa-user-tie"></i>
                </div>

                <h2>No Trainers Found</h2>

                <p>
                    You haven't added any trainers yet.
                </p>

                <a href="/admin/trainers/add" class="add-btn">
                    <i class="fa-solid fa-plus"></i>
                    Add First Trainer
                </a>

            </div>

        <% } %>

    </div>

</main>

</body>
</html>