<%- include("partials/header") %>

<!-- SIDEBAR -->
<!-- MAIN CONTENT -->
<main class="main">

    <!-- TOP BAR -->
    <header class="topbar">

        <div>
            <h1>Workout Plans</h1>
            <p>Choose a workout and start your fitness journey</p>
        </div>

        <div class="user-info">

            <div class="avatar">
                <i class="fa-solid fa-user"></i>
            </div>

            <div>
                <strong>FitTrack Member</strong>
                <small>Fitness Member</small>
            </div>

        </div>

    </header>


    <!-- PAGE HEADER -->
    <section class="page-header">

        <div>
            <span class="section-label">
                <i class="fa-solid fa-dumbbell"></i>
                FITNESS PROGRAMS
            </span>

            <h2>Available Workouts</h2>

            <p>
                Find the perfect workout according to your fitness level.
            </p>
        </div>

    </section>


    <!-- WORKOUT GRID -->
    <section class="workout-grid">

        <% if (!workouts || workouts.length === 0) { %>

            <div class="no-workout">

                <div class="empty-workout-icon">
                    <i class="fa-solid fa-dumbbell"></i>
                </div>

                <h2>No Workouts Available</h2>

                <p>
                    Workout plans will be added soon.
                </p>

            </div>

        <% } else { %>


            <% workouts.forEach(workout => { %>

                <div class="workout-card">

                    <!-- ICON -->
                    <div class="workout-icon">
                        <i class="fa-solid fa-dumbbell"></i>
                    </div>


                    <div class="workout-content">

                        <!-- CATEGORY -->
                        <span class="category">
                            <i class="fa-solid fa-layer-group"></i>
                            <%= workout.category || "Fitness" %>
                        </span>


                        <!-- WORKOUT NAME -->
                        <h2>
                            <%= workout.name || "Workout Plan" %>
                        </h2>


                        <!-- INFO -->
                        <div class="workout-info">

                            <span>
                                <i class="fa-regular fa-clock"></i>
                                <%= workout.duration || 0 %> min
                            </span>

                            <span>
                                <i class="fa-solid fa-chart-simple"></i>
                                <%= workout.level || "Beginner" %>
                            </span>

                        </div>


                        <!-- EXERCISES -->
                        <h3>
                            <i class="fa-solid fa-list-check"></i>
                            Exercises
                        </h3>


                        <ul>

                            <% if (workout.exercises && workout.exercises.length > 0) { %>

                                <% workout.exercises.forEach(exercise => { %>

                                    <li>

                                        <span class="exercise-name">
                                            <i class="fa-solid fa-circle-check"></i>
                                            <%= exercise.name %>
                                        </span>

                                        <span class="exercise-details">
                                            <%= exercise.sets %> Sets
                                            <span>×</span>
                                            <%= exercise.reps %> Reps
                                        </span>

                                    </li>

                                <% }) %>


                            <% } else { %>

                                <li class="no-exercises">
                                    <i class="fa-solid fa-circle-info"></i>
                                    No exercises added
                                </li>

                            <% } %>

                        </ul>


                        <!-- START WORKOUT -->
                        <a
                            href="/workouts/<%= workout._id %>"
                            class="start-btn"
                        >
                            <span>Start Workout</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                    </div>

                </div>

            <% }) %>

        <% } %>

    </section>

</main>


</body>
</html>