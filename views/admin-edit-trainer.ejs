
<%- include("partials/header") %>

<div class="admin-container">

    <!-- SIDEBAR -->

    <!-- MAIN CONTENT -->

    <main class="main admin-main">

        <div class="admin-header">

            <div>
                <h1>Edit Trainer</h1>

                <p>
                    Update trainer information
                </p>
            </div>

        </div>


        <div class="form-box">

            <form
                action="/admin/trainers/edit/<%= trainer._id %>"
                method="POST"
            >

                <label>Trainer Name</label>

                <input
                    type="text"
                    name="name"
                    value="<%= trainer.name %>"
                    required
                >


                <label>Specialization</label>

                <input
                    type="text"
                    name="specialization"
                    value="<%= trainer.specialization %>"
                    required
                >


                <label>Experience (Years)</label>

                <input
                    type="number"
                    name="experience"
                    value="<%= trainer.experience %>"
                    required
                >


                <label>Availability</label>

                <input
                    type="text"
                    name="availability"
                    value="<%= trainer.availability %>"
                    required
                >


                <div class="form-buttons">

                    <button type="submit">
                        Update Trainer
                    </button>

                    <a href="/admin/trainers">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </main>

</div>

</body>
</html>