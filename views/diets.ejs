<%- include("partials/header") %>

<!-- SIDEBAR -->
<!-- MAIN CONTENT -->
<main class="main">

    <!-- TOP BAR -->
    <header class="topbar">

        <div>
            <h1>
                <i class="fa-solid fa-apple-whole"></i>
                Diet Plans
            </h1>

            <p>
                Healthy nutrition plans for your fitness goals
            </p>
        </div>

        <div class="user-info">

            <div class="avatar">
                <i class="fa-solid fa-user"></i>
            </div>

            <div>
                <strong>FitTrack Member</strong>
                <small>Fitness Member</small>
            </div>

        </div>

    </header>


    <!-- PAGE HEADER -->
    <section class="page-header">

        <div>
            <span class="section-label">
                <i class="fa-solid fa-utensils"></i>
                NUTRITION PROGRAMS
            </span>

            <h2>
                Choose Your Diet Plan
            </h2>

            <p>
                Select a diet according to your fitness goal.
            </p>
        </div>

    </section>


    <!-- DIET GRID -->
    <section class="diet-grid">

        <% if (!diets || diets.length === 0) { %>

            <div class="no-diet">

                <div class="no-diet-icon">
                    <i class="fa-solid fa-bowl-food"></i>
                </div>

                <h2>
                    No Diet Plans Available
                </h2>

                <p>
                    Diet plans will be added soon.
                </p>

            </div>

        <% } else { %>


            <% diets.forEach(diet => { %>

                <div class="diet-card">

                    <!-- DIET ICON -->
                    <div class="diet-icon">
                        <i class="fa-solid fa-bowl-food"></i>
                    </div>


                    <!-- CATEGORY -->
                    <span class="category">

                        <i class="fa-solid fa-tag"></i>

                        <%= diet.category || "General Fitness" %>

                    </span>


                    <!-- DIET NAME -->
                    <h2>
                        <%= diet.name || "Diet Plan" %>
                    </h2>


                    <!-- CALORIES -->
                    <div class="calories">

                        <i class="fa-solid fa-fire-flame-curved"></i>

                        <strong>
                            <%= diet.calories || 0 %>
                        </strong>

                        kcal/day

                    </div>


                    <!-- MACROS -->
                    <div class="macros">

                        <span>

                            <i class="fa-solid fa-dumbbell"></i>

                            <small>Protein</small>

                            <strong>
                                <%= diet.protein || 0 %>g
                            </strong>

                        </span>


                        <span>

                            <i class="fa-solid fa-wheat-awn"></i>

                            <small>Carbs</small>

                            <strong>
                                <%= diet.carbs || 0 %>g
                            </strong>

                        </span>


                        <span>

                            <i class="fa-solid fa-droplet"></i>

                            <small>Fats</small>

                            <strong>
                                <%= diet.fats || 0 %>g
                            </strong>

                        </span>

                    </div>


                    <!-- VIEW DIET -->
                    <a
                        href="/diets/<%= diet._id %>"
                        class="view-btn"
                    >
                        <span>View Diet</span>

                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                </div>

            <% }) %>

        <% } %>

    </section>

</main>


</body>
</html>