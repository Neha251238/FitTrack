<%- include("partials/header") %>

<main class="main">

    <!-- Header -->
    <div class="header">
        <div class="page-heading">

            <div>
                <span class="page-label">
                    <i class="fa-solid fa-calendar-check"></i>
                    BOOKING MANAGEMENT
                </span>

                <h1>Manage Bookings</h1>

                <p>
                    View and manage trainer bookings.
                </p>
            </div>

            <!-- Booking Count -->
            <div class="user-count">

                <i class="fa-solid fa-calendar-days"></i>

                <div>
                    <span>Total Bookings</span>

                    <strong>
                        <%= bookings ? bookings.length : 0 %>
                    </strong>
                </div>

            </div>

        </div>
    </div>


    <!-- Bookings Table -->
    <div class="user-table booking-table">

        <div class="table-header">

            <div>
                <h2>Trainer Bookings</h2>

                <p>
                    Manage user sessions and booking status.
                </p>
            </div>

        </div>


        <% if (bookings && bookings.length > 0) { %>

            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Trainer</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>


                    <tbody>

                        <% bookings.forEach(booking => { %>

                            <tr>

                                <!-- USER -->
                                <td>

                                    <div class="user-cell">

                                        <div class="user-avatar">

                                            <%= booking.userId && booking.userId.name
                                                ? booking.userId.name.charAt(0).toUpperCase()
                                                : "U"
                                            %>

                                        </div>

                                        <div>

                                            <strong>
                                                <%= booking.userId
                                                    ? booking.userId.name
                                                    : "User Deleted"
                                                %>
                                            </strong>

                                            <small>
                                                FitTrack Member
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- TRAINER -->
                                <td>

                                    <span class="trainer-cell">

                                        <span class="trainer-small-icon">
                                            <i class="fa-solid fa-user-tie"></i>
                                        </span>

                                        <%= booking.trainerId
                                            ? booking.trainerId.name
                                            : "Trainer Deleted"
                                        %>

                                    </span>

                                </td>


                                <!-- DATE -->
                                <td>

                                    <span class="booking-date">

                                        <i class="fa-regular fa-calendar"></i>

                                        <%= booking.date %>

                                    </span>

                                </td>


                                <!-- TIME -->
                                <td>

                                    <span class="booking-time">

                                        <i class="fa-regular fa-clock"></i>

                                        <%= booking.time %>

                                    </span>

                                </td>


                                <!-- STATUS -->
                                <td>

                                    <form
                                        action="/admin/bookings/status/<%= booking._id %>"
                                        method="POST"
                                        class="status-form"
                                    >

                                        <div class="status-select-wrapper">

                                            <i class="fa-solid fa-circle-dot"></i>

                                            <select
                                                name="status"
                                                class="status-select <%= booking.status ? booking.status.toLowerCase() : 'booked' %>"
                                                onchange="this.form.submit()"
                                            >

                                                <option
                                                    value="Booked"
                                                    <%= booking.status === "Booked" ? "selected" : "" %>
                                                >
                                                    Booked
                                                </option>

                                                <option
                                                    value="Completed"
                                                    <%= booking.status === "Completed" ? "selected" : "" %>
                                                >
                                                    Completed
                                                </option>

                                                <option
                                                    value="Cancelled"
                                                    <%= booking.status === "Cancelled" ? "selected" : "" %>
                                                >
                                                    Cancelled
                                                </option>

                                            </select>

                                        </div>

                                    </form>

                                </td>


                                <!-- DELETE -->
                                <td>

                                    <form
                                        action="/admin/bookings/delete/<%= booking._id %>"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this booking?');"
                                    >

                                        <button
                                            type="submit"
                                            class="delete-btn"
                                        >

                                            <i class="fa-solid fa-trash"></i>

                                            Delete

                                        </button>

                                    </form>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>


        <% } else { %>

            <!-- Empty State -->
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="fa-solid fa-calendar-xmark"></i>
                </div>

                <h2>No Bookings Found</h2>

                <p>
                    There are currently no trainer bookings.
                </p>

            </div>

        <% } %>

    </div>

</main>


</body>
</html>