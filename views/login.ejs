<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>FitTrack - Login</title>

    <link rel="stylesheet" href="/css/auth.css">

</head>

<body>

<div class="auth-container">

    <div class="auth-box">

        <div class="logo">
            🏃
            <h1>FitTrack</h1>
        </div>

        <h2>Welcome Back!</h2>

        <p class="subtitle">
            Login to continue your fitness journey
        </p>


        <form action="/login" method="POST">

            <label>Email</label>

            <input
                type="email"
                name="email"
                placeholder="Enter your email"
                required
            >


            <label>Password</label>

            <input
                type="password"
                name="password"
                placeholder="Enter your password"
                required
            >


            <button type="submit">
                Login
            </button>

        </form>


        <p class="bottom-text">

            Don't have an account?

            <a href="/register">
                Create Account
            </a>

        </p>

    </div>

</div>

</body>

</html>