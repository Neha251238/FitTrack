<%- include("partials/header") %>

<div class="booking-page">

    <!-- BACK BUTTON -->
    <a href="/trainers" class="booking-back">
        <i class="fa-solid fa-arrow-left"></i>
        Back to Trainers
    </a>

    <!-- BOOKING CARD -->
    <div class="booking-card">

        <!-- TRAINER ICON -->
        <div class="booking-trainer-icon">
            <i class="fa-solid fa-user-tie"></i>
        </div>

        <!-- TITLE -->
        <h1>Book Session</h1>

        <h2>
            <%= trainer.name %>
        </h2>

        <!-- SPECIALIZATION -->
        <p class="booking-specialization">
            <i class="fa-solid fa-dumbbell"></i>
            <%= trainer.specialization %>
        </p>

        <!-- EXPERIENCE -->
        <p class="booking-trainer-detail">
            <i class="fa-solid fa-briefcase"></i>
            <%= trainer.experience %> Years Experience
        </p>

        <!-- AVAILABILITY -->
        <p class="booking-trainer-detail">
            <i class="fa-regular fa-clock"></i>
            <%= trainer.availability %>
        </p>

        <!-- BOOKING FORM -->
        <form
            action="/book-session/<%= trainer._id %>"
            method="POST"
            class="booking-form"
        >

            <!-- DATE -->
            <div class="booking-field">

                <label for="booking-date">
                    <i class="fa-regular fa-calendar-days"></i>
                    Select Date
                </label>

                <div class="booking-input-wrapper">
                    <i class="fa-regular fa-calendar"></i>

                    <input
                        type="date"
                        id="booking-date"
                        name="date"
                        required
                    >
                </div>

            </div>

            <!-- TIME -->
            <div class="booking-field">

                <label for="booking-time">
                    <i class="fa-regular fa-clock"></i>
                    Select Time
                </label>

                <div class="booking-input-wrapper">
                    <i class="fa-solid fa-clock"></i>

                    <input
                        type="time"
                        id="booking-time"
                        name="time"
                        required
                    >
                </div>

            </div>

            <!-- CONFIRM BUTTON -->
            <button
                type="submit"
                class="booking-confirm-btn"
            >
                <i class="fa-solid fa-calendar-check"></i>
                Confirm Booking
            </button>

        </form>

    </div>

</div>

<script>
    // Prevent selecting a past date
    const dateInput = document.getElementById("booking-date");

    if (dateInput) {
        const today = new Date();

        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, "0");
        const day = String(today.getDate()).padStart(2, "0");

        dateInput.min = `${year}-${month}-${day}`;
    }
</script>

</body>
</html>