<%- include("partials/header") %>
<div >

    <!-- SIDEBAR -->

    <!-- MAIN -->

    <main class="main">

        <div class="admin-header">

            <div>

                <h1>Edit Diet Plan</h1>

                <p>
                    Update diet plan information
                </p>

            </div>

        </div>


        <div class="form-box">

            <form
                action="/admin/diets/edit/<%= diet._id %>"
                method="POST"
            >

                <label>Diet Name</label>

                <input
                    type="text"
                    name="name"
                    value="<%= diet.name %>"
                    required
                >


                <label>Category</label>

                <input
                    type="text"
                    name="category"
                    value="<%= diet.category %>"
                    required
                >


                <label>Calories</label>

                <input
                    type="number"
                    name="calories"
                    value="<%= diet.calories %>"
                    required
                >


                <label>Protein (g)</label>

                <input
                    type="number"
                    name="protein"
                    value="<%= diet.protein %>"
                    required
                >


                <label>Carbs (g)</label>

                <input
                    type="number"
                    name="carbs"
                    value="<%= diet.carbs %>"
                    required
                >


                <label>Fats (g)</label>

                <input
                    type="number"
                    name="fats"
                    value="<%= diet.fats %>"
                    required
                >


                <label>Breakfast</label>

                <textarea
                    name="breakfast"
                    required
                ><%= diet.breakfast %></textarea>


                <label>Lunch</label>

                <textarea
                    name="lunch"
                    required
                ><%= diet.lunch %></textarea>


                <label>Dinner</label>

                <textarea
                    name="dinner"
                    required
                ><%= diet.dinner %></textarea>


                <label>Snacks</label>

                <textarea
                    name="snacks"
                    required
                ><%= diet.snacks %></textarea>


                <div class="form-buttons">

                    <button type="submit">
                        Update Diet
                    </button>

                    <a href="/admin/diets">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </main>

</div>

</body>

</html>