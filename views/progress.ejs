<%- include("partials/header") %>

<!-- SIDEBAR -->
<!-- MAIN -->
<main class="main">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div>
            <h1>My Progress</h1>

            <p>
                Track your fitness journey and improvements
            </p>
        </div>

    </div>


    <!-- CURRENT STATS -->
    <section class="stats">

        <!-- WEIGHT -->
        <div class="stat-card">

            <div class="stat-icon">
                <i class="fa-solid fa-weight-scale"></i>
            </div>

            <div>
                <p>Current Weight</p>

                <h2>
                    <%= progress.length > 0
                        ? progress[0].weight
                        : (user.weight || 0) %> kg
                </h2>
            </div>

        </div>


        <!-- BMI -->
        <div class="stat-card">

            <div class="stat-icon">
                <i class="fa-solid fa-chart-simple"></i>
            </div>

            <div>
                <p>Current BMI</p>

                <h2>
                    <%= progress.length > 0
                        ? progress[0].bmi
                        : "--" %>
                </h2>
            </div>

        </div>


        <!-- WORKOUTS -->
        <div class="stat-card">

            <div class="stat-icon">
                <i class="fa-solid fa-dumbbell"></i>
            </div>

            <div>
                <p>Workouts</p>

                <h2>
                    <%= progress.length > 0
                        ? progress[0].workouts
                        : 0 %>
                </h2>
            </div>

        </div>


        <!-- CALORIES -->
        <div class="stat-card">

            <div class="stat-icon">
                <i class="fa-solid fa-fire-flame-curved"></i>
            </div>

            <div>
                <p>Calories</p>

                <h2>
                    <%= progress.length > 0
                        ? progress[0].calories
                        : 0 %>
                </h2>
            </div>

        </div>

    </section>


    <!-- ADD PROGRESS -->
    <section class="progress-form">

        <div class="section-heading">

            <div class="heading-icon">
                <i class="fa-solid fa-plus"></i>
            </div>

            <div>
                <h2>Add Today's Progress</h2>

                <p>
                    Enter your fitness details for today.
                </p>
            </div>

        </div>


        <form action="/progress/add" method="POST">

            <div class="form-grid">

                <!-- WEIGHT -->
                <div class="input-group">

                    <label>
                        <i class="fa-solid fa-weight-scale"></i>
                        Weight (kg)
                    </label>

                    <input
                        type="number"
                        name="weight"
                        step="0.1"
                        required
                        placeholder="Enter weight"
                    >

                </div>


                <!-- WORKOUTS -->
                <div class="input-group">

                    <label>
                        <i class="fa-solid fa-dumbbell"></i>
                        Workouts Completed
                    </label>

                    <input
                        type="number"
                        name="workouts"
                        value="0"
                        min="0"
                        required
                    >

                </div>


                <!-- CALORIES -->
                <div class="input-group">

                    <label>
                        <i class="fa-solid fa-fire-flame-curved"></i>
                        Calories Burned
                    </label>

                    <input
                        type="number"
                        name="calories"
                        value="0"
                        min="0"
                        required
                    >

                </div>

            </div>


            <button type="submit" class="add-progress-btn">

                <i class="fa-solid fa-plus"></i>

                Add Progress

            </button>

        </form>

    </section>


    <!-- HISTORY -->
    <section class="history">

        <div class="section-title">

            <div class="history-title-icon">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>

            <div>

                <h2>Progress History</h2>

                <p>
                    Your previous fitness records
                </p>

            </div>

        </div>


        <div class="table-container">

            <table>

                <thead>

                    <tr>

                        <th>
                            <i class="fa-regular fa-calendar"></i>
                            Date
                        </th>

                        <th>
                            <i class="fa-solid fa-weight-scale"></i>
                            Weight
                        </th>

                        <th>
                            <i class="fa-solid fa-chart-simple"></i>
                            BMI
                        </th>

                        <th>
                            <i class="fa-solid fa-dumbbell"></i>
                            Workouts
                        </th>

                        <th>
                            <i class="fa-solid fa-fire-flame-curved"></i>
                            Calories
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <% if (progress.length === 0) { %>

                        <tr>

                            <td colspan="5" class="empty-state">

                                <i class="fa-solid fa-chart-line"></i>

                                <span>
                                    No progress records yet.
                                </span>

                            </td>

                        </tr>

                    <% } %>


                    <% progress.forEach(item => { %>

                        <tr>

                            <td>
                                <%= new Date(item.date)
                                    .toLocaleDateString("en-IN") %>
                            </td>

                            <td>
                                <%= item.weight %> kg
                            </td>

                            <td>
                                <%= item.bmi %>
                            </td>

                            <td>
                                <%= item.workouts %>
                            </td>

                            <td>
                                <%= item.calories %>
                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </section>

</main>

