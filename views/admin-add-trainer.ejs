<%- include("partials/header") %>

<main class="main">

    <div class="form-page">

        <!-- Page Header -->
        <div class="form-page-header">

            <div>

                <span class="page-label">
                    <i class="fa-solid fa-user-plus"></i>
                    TRAINER MANAGEMENT
                </span>

                <h1>Add New Trainer</h1>

                <p>
                    Add a new fitness trainer to your FitTrack platform.
                </p>

            </div>

        </div>


        <!-- Form Card -->
        <div class="form-box">

            <div class="form-box-header">

                <div class="form-icon">
                    <i class="fa-solid fa-user-tie"></i>
                </div>

                <div>
                    <h2>Trainer Information</h2>

                    <p>
                        Enter the trainer's professional details.
                    </p>
                </div>

            </div>


            <form
                action="/admin/trainers/add"
                method="POST"
                class="admin-form"
            >

                <!-- Trainer Name -->
                <div class="form-group">

                    <label for="name">
                        <i class="fa-solid fa-user"></i>
                        Trainer Name
                    </label>

                    <input
                        id="name"
                        type="text"
                        name="name"
                        placeholder="Enter trainer name"
                        autocomplete="name"
                        required
                    >

                </div>


                <!-- Specialization -->
                <div class="form-group">

                    <label for="specialization">
                        <i class="fa-solid fa-dumbbell"></i>
                        Specialization
                    </label>

                    <input
                        id="specialization"
                        type="text"
                        name="specialization"
                        placeholder="e.g. Strength Training"
                        required
                    >

                </div>


                <!-- Experience -->
                <div class="form-group">

                    <label for="experience">
                        <i class="fa-solid fa-briefcase"></i>
                        Experience
                    </label>

                    <div class="input-with-suffix">

                        <input
                            id="experience"
                            type="number"
                            name="experience"
                            min="0"
                            placeholder="e.g. 5"
                            required
                        >

                        <span>Years</span>

                    </div>

                </div>


                <!-- Availability -->
                <div class="form-group">

                    <label for="availability">
                        <i class="fa-regular fa-clock"></i>
                        Availability
                    </label>

                    <input
                        id="availability"
                        type="text"
                        name="availability"
                        placeholder="e.g. 9 AM - 1 PM"
                        required
                    >

                </div>


                <!-- Buttons -->
                <div class="form-actions">

                    <a
                        href="/admin/trainers"
                        class="cancel-btn"
                    >
                        <i class="fa-solid fa-arrow-left"></i>
                        Cancel
                    </a>


                    <button
                        type="submit"
                        class="add-btn submit-btn"
                    >
                        <i class="fa-solid fa-user-plus"></i>
                        Add Trainer
                    </button>

                </div>

            </form>

        </div>

    </div>

</main>


</body>
</html>