<%- include("partials/header") %>

<main class="main">

    <!-- Header -->
    <div class="header">

        <div class="page-heading">

            <div>

                <span class="page-label">
                    <i class="fa-solid fa-apple-whole"></i>
                    DIET MANAGEMENT
                </span>

                <h1>Manage Diet Plans</h1>

                <p>
                    Add, edit and manage fitness diet plans.
                </p>

            </div>


            <a
                href="/admin/diets/add"
                class="add-btn"
            >
                <i class="fa-solid fa-plus"></i>
                Add Diet Plan
            </a>

        </div>

    </div>


    <!-- Diet Cards -->
    <div class="trainer-grid diet-grid">

        <% if (diets && diets.length > 0) { %>

            <% diets.forEach(diet => { %>

                <div class="trainer-card diet-card">

                    <!-- Diet Icon -->
                    <div class="trainer-icon diet-icon">
                        <i class="fa-solid fa-apple-whole"></i>
                    </div>


                    <!-- Diet Name -->
                    <h2>
                        <%= diet.name %>
                    </h2>


                    <!-- Category -->
                    <p class="specialization">
                        <i class="fa-solid fa-layer-group"></i>
                        <%= diet.category %>
                    </p>


                    <!-- Nutrition -->
                    <div class="diet-nutrition">

                        <!-- Calories -->
                        <div class="diet-nutrition-row">

                            <span>
                                <i class="fa-solid fa-fire-flame-curved"></i>
                                Calories
                            </span>

                            <strong>
                                <%= diet.calories %> kcal
                            </strong>

                        </div>


                        <!-- Protein -->
                        <div class="diet-nutrition-row">

                            <span>
                                <i class="fa-solid fa-dumbbell"></i>
                                Protein
                            </span>

                            <strong>
                                <%= diet.protein %> g
                            </strong>

                        </div>


                        <!-- Carbs -->
                        <div class="diet-nutrition-row">

                            <span>
                                <i class="fa-solid fa-wheat-awn"></i>
                                Carbs
                            </span>

                            <strong>
                                <%= diet.carbs %> g
                            </strong>

                        </div>


                        <!-- Fats -->
                        <div class="diet-nutrition-row">

                            <span>
                                <i class="fa-solid fa-droplet"></i>
                                Fats
                            </span>

                            <strong>
                                <%= diet.fats %> g
                            </strong>

                        </div>

                    </div>


                    <!-- Buttons -->
                    <div class="action-buttons">

                        <a
                            href="/admin/diets/edit/<%= diet._id %>"
                            class="edit-btn"
                        >
                            <i class="fa-solid fa-pen-to-square"></i>
                            Edit
                        </a>


                        <form
                            action="/admin/diets/delete/<%= diet._id %>"
                            method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this diet plan?');"
                        >

                            <button
                                type="submit"
                                class="delete-btn"
                            >
                                <i class="fa-solid fa-trash"></i>
                                Delete
                            </button>

                        </form>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <!-- Empty State -->
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="fa-solid fa-apple-whole"></i>
                </div>

                <h2>No Diet Plans Found</h2>

                <p>
                    You haven't added any diet plans yet.
                </p>

                <a
                    href="/admin/diets/add"
                    class="add-btn"
                >
                    <i class="fa-solid fa-plus"></i>
                    Add First Diet Plan
                </a>

            </div>

        <% } %>

    </div>

</main>

</body>
</html>