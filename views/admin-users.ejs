<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>FitTrack - Users</title>

    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

    <aside class="sidebar">

        <h2>FitTrack</h2>
        <p>Admin Panel</p>

        <nav>
            <a href="/admin/dashboard">🏠 Dashboard</a>
            <a href="/admin/users">👥 Users</a>
            <a href="/admin/trainers">👨‍🏫 Trainers</a>
            <a href="/admin/workouts">🏋️ Workouts</a>
            <a href="/admin/diets">🥗 Diet Plans</a>
            <a href="/admin/bookings">📅 Bookings</a>

            <a href="/dashboard">👤 User Dashboard</a>
            <a href="/logout" class="logout">🚪 Logout</a>
        </nav>

    </aside>


    <main class="main">

        <div class="header">
            <h1>Manage Users</h1>
            <p>View and manage registered users.</p>
        </div>


        <div class="user-table">

            <table>

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Age</th>
                        <th>Weight</th>
                        <th>Goal</th>
                        <th>Role</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <% users.forEach(user => { %>

                        <tr>

                            <td>
                                <%= user.name %>
                            </td>

                            <td>
                                <%= user.email %>
                            </td>

                            <td>
                                <%= user.age || "-" %>
                            </td>

                            <td>
                                <%= user.weight || "-" %> kg
                            </td>

                            <td>
                                <%= user.goal || "-" %>
                            </td>

                            <td>
                                <%= user.role %>
                            </td>

                            <td>

                                <% if (user.role !== "admin") { %>

                                    <form
                                        action="/admin/users/delete/<%= user._id %>"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this user?');"
                                    >

                                        <button class="delete-btn">
                                            Delete
                                        </button>

                                    </form>

                                <% } else { %>

                                    <span>Admin</span>

                                <% } %>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </main>

</body>
</html>