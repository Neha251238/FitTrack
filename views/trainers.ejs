<%- include("partials/header") %>

<!-- SIDEBAR -->
<!-- MAIN CONTENT -->
<main class="main trainer-page">

    <div class="trainer-page-header">

        <div>

            <span class="trainer-section-label">
                <i class="fa-solid fa-user-tie"></i>
                FITNESS EXPERTS
            </span>

            <h1>
                Our Trainers
            </h1>

            <p>
                Choose a trainer and book your fitness session.
            </p>

        </div>

    </div>


    <!-- TRAINER GRID -->
    <div class="trainer-grid">

        <% if (!trainers || trainers.length === 0) { %>

            <div class="trainer-empty">

                <div class="trainer-empty-icon">
                    <i class="fa-solid fa-user-tie"></i>
                </div>

                <h2>No Trainers Available</h2>

                <p>
                    Trainer profiles will be added soon.
                </p>

            </div>

        <% } else { %>

            <% trainers.forEach(trainer => { %>

                <div class="trainer-card">

                    <!-- Trainer Icon -->
                    <div class="trainer-avatar">

                        <i class="fa-solid fa-user-tie"></i>

                    </div>


                    <!-- Trainer Name -->
                    <h2>
                        <%= trainer.name %>
                    </h2>


                    <!-- Specialization -->
                    <p class="trainer-specialization">

                        <i class="fa-solid fa-dumbbell"></i>

                        <%= trainer.specialization %>

                    </p>


                    <!-- Experience -->
                    <p class="trainer-detail">

                        <i class="fa-solid fa-briefcase"></i>

                        <%= trainer.experience %>
                        Years Experience

                    </p>


                    <!-- Availability -->
                    <p class="trainer-detail">

                        <i class="fa-regular fa-clock"></i>

                        <%= trainer.availability %>

                    </p>


                    <!-- Book Session -->
                    <a
                        href="/book-session/<%= trainer._id %>"
                        class="trainer-book-btn"
                    >

                        <i class="fa-solid fa-calendar-check"></i>

                        Book Session

                    </a>

                </div>

            <% }) %>

        <% } %>

    </div>

</main>


</body>
</html>